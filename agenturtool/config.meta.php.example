<?php
/**
 * Meta-/Graph-API-Zugangsdaten — Fallback zu den Umgebungsvariablen.
 *
 * SO NUTZEN:
 *   1. Diese Datei auf dem Server kopieren nach:  agenturtool/config.meta.php
 *   2. app_secret eintragen (app_id + redirect_uri sind schon gesetzt).
 *   3. NICHT committen — config.meta.php steht in .gitignore (Secret bleibt aus Git).
 *
 *   ⚠️ WICHTIG — Env-Vars haben VORRANG vor dieser Datei (siehe api/meta_env.php):
 *   erst getenv()/$_SERVER (META_APP_ID/SECRET/REDIRECT_URI/GRAPH_VERSION), dann
 *   config.meta.php nur für LEERE Felder. Wenn auf dem Server noch alte
 *   SetEnv META_*-Zeilen (z. B. in agenturtool/api/.htaccess) stehen, gewinnen die.
 *   -> Entweder die alten SetEnv-Zeilen entfernen, oder Werte konsistent halten.
 *
 * app_id / app_secret:  Meta-App -> App-Einstellungen -> Grundlegendes.
 * redirect_uri:  muss ZEICHENGENAU der in der Meta-App unter
 *   "Facebook Login for Business -> Einstellungen -> Gültige OAuth-Redirect-URIs"
 *   hinterlegten URI entsprechen. Leer -> wird aus dem Request abgeleitet.
 * graph_version:  optional, Default v21.0.
 */
return [
    'app_id'        => '1009731845363205',
    'app_secret'    => 'HIER-DAS-META-APP-SECRET',
    'redirect_uri'  => 'https://dodidis-media.de/agenturtool/api/meta_callback.php',
    'graph_version' => 'v21.0',

    // ── WhatsApp Cloud API (Kommunikation / Team-Posteingang) ──────────────
    // Aus der Meta-App -> WhatsApp -> API-Setup:
    //   wa_phone_number_id : ID der Business-Telefonnummer (NICHT die Nummer selbst)
    //   wa_token           : Dauer-Token (System-User, Scope whatsapp_business_messaging)
    //   wa_verify_token    : frei wählbares Passwort — MUSS mit dem im Webhook
    //                        (Meta-App -> WhatsApp -> Konfiguration) übereinstimmen
    'wa_phone_number_id' => 'HIER-DIE-PHONE-NUMBER-ID',
    'wa_token'           => 'HIER-DER-WHATSAPP-DAUER-TOKEN',
    'wa_verify_token'    => 'FREI-WAEHLBARES-VERIFY-PASSWORT',

    // ── Instagram-Automatisierung (Auto-Antworten/DMs auf Kommentare) ──────
    // Ersetzt ManyChat: Meta ruft bei neuen Kommentaren den Webhook auf
    //   agenturtool/api/ig_webhook.php  (Meta-App -> Webhooks -> Instagram,
    //   Feld „comments"). Der Verify-Token ist frei wählbar und MUSS mit dem in
    //   der Webhook-Konfiguration hinterlegten übereinstimmen.
    //   Nötige Berechtigungen: instagram_manage_comments (öffentliche Antwort)
    //   und instagram_manage_messages (private DM als Antwort auf Kommentar).
    'ig_verify_token'    => 'FREI-WAEHLBARES-IG-VERIFY-PASSWORT',
];

DirectoryIndex index.php

# index.html ist nur Template — Direktzugriff verbieten, immer durch index.php laufen lassen
<Files "index.html">
    Require all denied
</Files>

# Sensible Dateien schützen
<FilesMatch "^(config\.php|config\.nas\.php|install\.sql|seed_users\.sql|migrate_legacy\.php|agentur-backup-.*\.json|Fehler\.log|schema\.sql)$">
    Require all denied
</FilesMatch>

# Versteckte Dateien
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

Options -Indexes

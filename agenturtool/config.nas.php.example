/**
 * NAS-WebDAV-Zugangsdaten — Fallback zu den Umgebungsvariablen.
 *
 * SO NUTZEN:
 *   1. Diese Datei auf dem Server kopieren nach:  agenturtool/config.nas.php
 *   2. Unten NUR das Passwort eintragen (base + user sind schon gesetzt).
 *   3. NICHT committen — config.nas.php steht in .gitignore (Passwort bleibt aus Git).
 *
 * Wird herangezogen, wenn die Env-Vars NAS_DAV_BASE/USER/PASS leer sind
 * (siehe api/nas_env.php) — zuverlässig, unabhängig von Apache/PHP-FPM-Env.
 *
 * Aufbau (permanenter Zugang über eigenen Netcup-vServer):
 *   Tool  ->  https://nas.dodidis-media.de   (Caddy auf dem vServer, Let's-Encrypt-HTTPS)
 *         ->  Tailscale (WireGuard, direkt)   ->  NAS-WebDAV :5005
 *   Der Hostname nas.dodidis-media.de ist FEST. Uploads UND Downloads laufen
 *   automatisch darüber (alles geht durch NasWebDAV) — kein Code-Change nötig.
 *
 * 'base' = kompletter WebDAV-Pfad inkl. Host und Zielordner, OHNE End-Slash.
 *          '/Test' ist die WebDAV-Freigabe, in der die Projektordner liegen.
 */
return [
    'base' => 'https://nas.dodidis-media.de/Test',
    'user' => 'toolsvc',
    'pass' => 'HIER-DAS-NAS-WEBDAV-PASSWORT',

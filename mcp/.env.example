# Basis-URL der Agenturtool-API (ohne abschließenden Slash)
DODIDIS_API_BASE=https://dodidis-media.de/agenturtool/api

# Persönlicher API-Token (im Tool: Profil → „API-Token" → Neuen Token erzeugen).
# Der MCP-Server handelt mit genau den Rechten dieses Benutzers.
DODIDIS_API_TOKEN=dm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Nur für den REMOTE-Betrieb (http.ts / vServer) ────────────────────────────
# Geheimes URL-Segment, das den Endpunkt schützt (min. 16 Zeichen, zufällig).
# Connector-URL in claude.ai:  https://<host>/mcp/<MCP_URL_SECRET>
# Erzeugen z. B. mit:  openssl rand -hex 24
MCP_URL_SECRET=hier-ein-langes-zufaelliges-geheimnis
# Port, auf dem der HTTP-Server lokal lauscht (Caddy proxyt darauf).
PORT=8787

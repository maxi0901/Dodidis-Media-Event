# /etc/tusd/tusd.env  — Secrets für tusd + NAS-Push-Hook. NICHT committen.
# Kopiervorlage: diese Datei nach /etc/tusd/tusd.env kopieren und ausfüllen.

# Agenturtool-Basis (ohne abschließenden Slash)
APP_BASE=https://dodidis-media.de/agenturtool

# = config.php['api_key'] im Agenturtool. Der Hook nutzt ihn für tus_verify.php
# (HMAC-Prüfung des Zielpfads). MUSS exakt übereinstimmen.
APP_API_KEY=DEIN_API_KEY

# NAS-WebDAV — identisch zu NAS_DAV_BASE / config.nas.php im Agenturtool
NAS_BASE=https://nas.dodidis-media.de/Test
NAS_USER=toolsvc
NAS_PASS=DAS_NAS_PASSWORT

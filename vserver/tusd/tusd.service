[Unit]
Description=tusd resumable upload server (Agenturtool)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/tusd/tusd.env
# Puffer auf dem vServer; GET-Download bewusst AKTIV (kein -disable-download),
# damit die Datei im Zeitfenster bis zur NAS-Sicherung ladbar bleibt.
# post-finish-Hook schiebt sie danach auf den NAS und löscht den Puffer.
ExecStart=/usr/local/bin/tusd \
  -host 127.0.0.1 \
  -port 1080 \
  -base-path /files/ \
  -upload-dir /var/lib/tusd-data \
  -hooks-dir /etc/tusd/hooks \
  -hooks-enabled-events pre-create,post-finish \
  -behind-proxy
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
